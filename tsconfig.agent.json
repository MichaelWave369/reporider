{
  "compilerOptions": {
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".agent-build"
  },
  "include": [
    "src/agent/**/*.ts",
    "test/agentRail.fixtures.ts",
    "test/reviewDesk.fixtures.ts"
  ]
}
